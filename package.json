{
  "name": "TaskManager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "cross-env ENVFILE=.env.dev react-native run-android --mode=devDebug --appId=com.taskManagementApp.dev",
    "android:prod": "cross-env ENVFILE=.env.prod react-native run-android --mode=prodRelease --appId=com.taskManagement.prod",
    "ios": "react-native run-ios",
    "ios:dev": "cross-env ENVFILE=.env.dev react-native run-ios --scheme Dev",
    "ios:prod": "cross-env ENVFILE=.env.prod react-native run-ios --scheme Prod",
    "start": "react-native start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^21.12.0",
    "@react-native-firebase/auth": "^21.12.0",
    "@react-native-firebase/firestore": "^21.12.0",
    "@react-native-firebase/messaging": "^21.12.0",
    "@react-native/new-app-screen": "0.82.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.0.15",
    "@react-navigation/native-stack": "^7.2.1",
    "@reduxjs/toolkit": "^2.6.1",
    "date-fns": "^4.1.0",
    "react": "19.1.1",
    "react-hook-form": "^7.54.2",
