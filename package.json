    "react-native-gesture-handler": "^2.24.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.10.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.2.0",
    "realm": "^20.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
